# =====================================================================
# Frontend Environment Configuration
# =====================================================================
# Copy this file to .env.local for local development
# For production (Render), set these in the dashboard

# API Configuration
# Development: http://localhost:8000
# Production: Your Render backend URL (e.g., https://supportdesk-ai-backend.onrender.com)
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Auth Configuration
# Set to true for local development without Supabase
# Set to false for production with real Supabase
VITE_USE_MOCK_AUTH=true

# Supabase Configuration (Optional - for production)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
VITE_APP_NAME=SupportDesk AI
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_EXPLANATIONS=true
