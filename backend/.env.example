# =====================================================================
# SupportDesk AI - Backend Configuration
# =====================================================================
# Copy this file to .env for local development
# For Render deployment, set these variables in the dashboard

# --------- ENVIRONMENT ---------
# Options: development, production
ENVIRONMENT=development

# --------- API SERVER ---------
PORT=8000

# --------- DATABASE (Supabase) ---------
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# --------- CORS Configuration ---------
# Development: Leave empty or set to local frontend URL
# Production (Render): Will be auto-set to your frontend URL
# Format: comma-separated origins (e.g., "https://yourapp.com,https://www.yourapp.com")
ALLOWED_ORIGINS=

# --------- ML MODEL ---------
MODEL_VERSION=2.1.0

# --------- Optional: Monitoring ---------
LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=false
